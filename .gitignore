# PlatformIO
.pio/
.pioenvs/
.piolibdeps/
.vscode/
*.bin
*.elf
*.map

# pioarduino / ESP-IDF build artifacts (generated by the ESP32 builds)
.dummy/
managed_components/
sdkconfig
sdkconfig.*
/CMakeLists.txt

# Build output we DO want to keep out of git (CI produces it)
firmware*.bin

# Reference material (proprietary / third-party — not redistributable)
sources/

# Python (daemon / tools)
__pycache__/
*.pyc
tools/.venv-mdi/
tools/.venv-stl/

# Local usage-daemon config (may contain API keys)
daemon/usage-daemon.json

# Local credentials store (never commit tokens)
daemon/credentials*.json
daemon/credentials*.json.*
daemon/.credentials-*

# Generated by daemon/install.bat
daemon/run_daemon.vbs

# OS / editor cruft
.DS_Store
Thumbs.db
*.swp
*~

.playwright-mcp/

# pioarduino-generated dependency lock
dependencies.lock

# Release staging directory
dist/

# Local PlatformIO/toolchain venv
.venv/
