{
  "device": "http://smalltv.local",
  "interval": 60,
  "timeout": 10,
  "providers": [
    {
      "id": "claude",
      "name": "Claude",
      "url": "http://127.0.0.1:8787/",
      "adapter": "claude-legacy"
    },
    {
      "id": "chatgpt",
      "name": "Codex",
      "adapter": "codex",
      "authFile": "~/.codex/auth.json"
    },
    {
      "id": "deepseek",
      "name": "DeepSeek",
      "adapter": "deepseek",
      "apiKeyEnv": "DEEPSEEK_API_KEY",
      "usageUrl": "http://127.0.0.1:8789/usage",
      "usagePath": "total_tokens",
      "usageLabel": "tokens",
      "usageBudget": 0
    }
  ]
}
